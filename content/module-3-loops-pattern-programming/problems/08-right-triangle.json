{
  "id": "08-right-triangle",
  "title": "Right Triangle of Stars",
  "type": "program",
  "difficulty": "easy",
  "description": "Read the number of rows `n` and print a right-angled triangle of `*`.\n\nFor `4`:\n```\n*\n**\n***\n****\n```",
  "starter_code": "n = int(input())\n# Print the triangle\n",
  "concepts": [
    "star-patterns",
    "nested-loops"
  ],
  "visible_tests": [
    {
      "stdin": "4\n",
      "expected": "*\n**\n***\n****"
    }
  ],
  "hidden_tests": [
    {
      "stdin": "1\n",
      "expected": "*"
    },
    {
      "stdin": "6\n",
      "expected": "*\n**\n***\n****\n*****\n******"
    },
    {
      "stdin": "3\n",
      "expected": "*\n**\n***"
    }
  ],
  "hints": [],
  "solution_code": "n = int(input())\nfor r in range(1, n + 1):\n    print('*' * r)\n"
}
