{
  "id": "07-multiplication-table",
  "title": "Multiplication Table",
  "type": "program",
  "difficulty": "easy",
  "description": "Read a number `n` and print its table from 1 to 10, one line each, in the form `n x i = result`.\n\nExample for `3`:\n```\n3 x 1 = 3\n3 x 2 = 6\n...\n```",
  "starter_code": "n = int(input())\n# Print the table\n",
  "concepts": [
    "for-loop",
    "range",
    "f-strings"
  ],
