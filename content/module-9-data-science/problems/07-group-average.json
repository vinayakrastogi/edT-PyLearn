            "marks": 15
          }
        ]
      ],
      "expected": "{'A': 20.0, 'B': 12.5}"
    },
    {
      "input": [
        [
          {
            "class": "C",
            "marks": 33
          },
          {
            "class": "C",
            "marks": 34
          },
          {
            "class": "C",
            "marks": 34
          }
        ]
      ],
      "expected": "{'C': 33.67}"
    }
