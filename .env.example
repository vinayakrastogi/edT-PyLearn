# =============================================================================
# Database
# =============================================================================
POSTGRES_USER=edt_user
POSTGRES_PASSWORD=edt_password
POSTGRES_DB=edt_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://edt_user:edt_password@localhost:5432/edt_db

# =============================================================================
# Auth / Security
# =============================================================================
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=  # Omit for host-only cookies.
TRUSTED_HOSTS=["*"]
SECRET_KEY=change-me-to-a-long-random-string-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

GEMINI_API_KEY=
GROQ_API_KEY=

# =============================================================================
# pgAdmin (optional local UI)
# =============================================================================
PGADMIN_EMAIL=admin@edt.local
PGADMIN_PASSWORD=admin

# =============================================================================
# Backend
# =============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
CONTENT_DIR=../content

# Code execution sandbox for learner code.
#   local  = subprocess with a scrubbed environment and resource limits (development only!)
#   docker = disposable container on a Docker-capable host (build docker/sandbox.Dockerfile)
#   remote = authenticated isolated runner; recommended for a hosted backend
#   disabled = HTTP 503 for execution and grading; other features remain available
SANDBOX_MODE=local
SANDBOX_DOCKER_IMAGE=pylearn-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_CONCURRENT=2
SANDBOX_RUNNER_URL=
SANDBOX_RUNNER_KEY=
RUN_RATE_LIMIT_PER_MINUTE=30
PUBLIC_API_ENABLED=true
PUBLIC_API_KEY=pylearn-demo

# =============================================================================
# Frontend (Vite)
# =============================================================================
VITE_API_URL=

# Browser-facing PyLearn address (used after Google OAuth).
FRONTEND_URL=http://localhost:5173
SERVE_FRONTEND=false

# LifeAdmin is hosted independently; local/ngrok URLs are optional alternatives.
LIFEADMIN_API_URL=https://lifeadmin-api-aditya.onrender.com
# Same secret as LIFEADMIN_API_KEY in LifeAdmin/.env; keep server-side.
LIFEADMIN_API_KEY=
LIFEADMIN_TIMEOUT_SECONDS=75
# Keep stable; make unique if multiple PyLearn installations use one LifeAdmin.
LIFEADMIN_CLIENT_ID=pylearn

# Docker uses the same public URL, regardless of which device hosts LifeAdmin.
LIFEADMIN_DOCKER_API_URL=https://lifeadmin-api-aditya.onrender.com
# Create/update the demo student and faculty logins; unrelated accounts are kept.
SEED_DEMO_USER=true
