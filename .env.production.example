# Example only: use provider environment settings, never commit actual secrets.
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/edt?sslmode=require
SECRET_KEY=replace_me_with_a_random_secret_of_at_least_32_characters
SESSION_SECRET=replace_me_with_another_random_secret_of_at_least_32_characters
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Keep COOKIE_DOMAIN unset for host-only cookies.
FRONTEND_URL=https://YOUR_EDT_SERVICE.onrender.com
BACKEND_CORS_ORIGINS=["https://YOUR_EDT_SERVICE.onrender.com"]
TRUSTED_HOSTS=["YOUR_EDT_SERVICE.onrender.com"]
# The Docker image includes React; use this same-origin deployment on Render.
SERVE_FRONTEND=true
CONTENT_DIR=/app/content
# Render terminates HTTPS at its managed proxy. Only use * behind a trusted proxy.
FORWARDED_ALLOW_IPS=*
PUBLIC_API_ENABLED=false
SEED_DEMO_USER=true
# Safely disabled until a separate Docker-capable runner is configured.
# Then change to remote and set both runner values below. No local fallback.
SANDBOX_MODE=disabled
SANDBOX_RUNNER_URL=
SANDBOX_RUNNER_KEY=
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_CONCURRENT=2
LIFEADMIN_API_URL=https://YOUR_LIFEADMIN_API.onrender.com
LIFEADMIN_API_KEY=
LIFEADMIN_CLIENT_ID=pylearn
LIFEADMIN_TIMEOUT_SECONDS=75
GROQ_API_KEY=
