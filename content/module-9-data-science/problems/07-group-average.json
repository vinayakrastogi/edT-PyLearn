  "hints": [],
  "solution_code": "import pandas as pd\n\ndef class_averages(rows):\n    df = pd.DataFrame(rows)\n    means = df.groupby('class')['marks'].mean().round(2)\n    return {k: float(v) for k, v in means.items()}\n"
}
